{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "certify-the-checker readout",
  "type": "object",
  "required": ["standard", "claim_id", "location", "build_config", "checkers", "cells", "control_grade", "note"],
  "properties": {
    "standard": {"type": "string"},
    "claim_id": {"type": "string"},
    "location": {"type": "string"},
    "bug_lines_why": {"type": "string"},
    "build_config": {"type": "string"},
    "checkers": {"type": "object", "additionalProperties": {"enum": ["CLEAN", "BUG", "SKIPPED"]}},
    "cells": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input_class", "checker", "checker_verdict", "execution", "coverage_depth", "result"],
        "properties": {
          "input_class": {"type": "string"},
          "checker": {"type": "string"},
          "checker_verdict": {"enum": ["CLEAN", "BUG", "SKIPPED"]},
          "execution": {"enum": ["CLEAN", "BUG", "NOTRIGGER", "ERROR"]},
          "coverage_depth": {"enum": ["none", "partial", "line", "branch", "condition", "input-class"]},
          "result": {"enum": ["certify_clean", "clean, but uncontrolled", "checker missed a real bug", "both found it",
                              "checker reports a bug that this input did not trigger", "not covered",
                              "checker not run", "error"]}
        }
      }
    },
    "coverage": {"type": "object"},
    "control_grade": {"enum": ["controlled", "uncontrolled"]},
    "note": {"type": "string"}
  }
}
